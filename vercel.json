{
  "version": 2,
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/pix",
      "dest": "/api/pix.js"
    },
    {
      "src": "/api/check_status",
      "dest": "/api/check_status.js"
    },
    {
      "src": "/api/status/([^/]+)",
      "dest": "/api/check_status.js?id=$1"
    },
    {
      "src": "/api/upload-comprovante",
      "dest": "/api/upload-comprovante.js"
    },
    {
      "src": "/xpay-proxy/(.*)",
      "dest": "https://api.xpaybrasil.com/v1/$1"
    },
    {
      "src": "^/sobre$",
      "headers": {
        "Content-Type": "text/html; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/contato$",
      "headers": {
        "Content-Type": "text/html; charset=utf-8"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/recarga/?$",
      "dest": "/recarga/index.html"
    }
  ]
}
