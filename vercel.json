{
  "version": 2,
  "rewrites": [
    {
      "source": "/xpay-proxy/:path*",
      "destination": "https://api.xpaybrasil.com/v1/:path*"
    },
    {
      "source": "/api/utmify",
      "destination": "/api/utmify.js"
    },
    {
      "source": "/api/webhook/xpay",
      "destination": "/api/webhook/xpay.js"
    },
    {
      "source": "/api/webhook",
      "destination": "/api/webhook/xpay.js"
    },
    {
      "source": "/api/status/:id",
      "destination": "/api/status/[id]?id=:id"
    },
    {
      "source": "/73653734543345",
      "destination": "/73653734543345/index.html"
    },
    {
      "source": "/73653734543345/",
      "destination": "/73653734543345/index.html"
    },
    {
      "source": "/73653734543345/recarga",
      "destination": "/73653734543345/recarga/index.html"
    },
    {
      "source": "/73653734543345/recarga/",
      "destination": "/73653734543345/recarga/index.html"
    }
  ],
  "headers": [
    {
      "source": "/73653734543345/sobre",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/73653734543345/contato",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ]
}
