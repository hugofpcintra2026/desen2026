{
  "version": 2,
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api/index.js"
    },
    {
      "src": "/xpay-proxy/(.*)",
      "dest": "https://api.xpaybrasil.com/v1/$1"
    },
    {
      "src": "/api/utmify",
      "dest": "/api/utmify.js"
    },
    {
      "src": "/api/webhook/xpay",
      "dest": "/api/webhook/xpay.js"
    },
    {
      "src": "/api/webhook",
      "dest": "/api/webhook/xpay.js"
    },
    {
      "src": "/api/status/([^/]+)",
      "dest": "/api/status/[id].js?id=$1"
    },
    {
      "src": "^/73653734543345/sobre$",
      "headers": {
        "Content-Type": "text/html; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/73653734543345/contato$",
      "headers": {
        "Content-Type": "text/html; charset=utf-8"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/73653734543345/?$",
      "dest": "/73653734543345/index.html"
    },
    {
      "src": "^/73653734543345/recarga/?$",
      "dest": "/73653734543345/recarga/index.html"
    }
  ]
}
